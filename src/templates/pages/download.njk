<section class="page-head">
    <div class="container">
        <span class="section-head__eyebrow">Download</span>
        <h1 class="page-head__title">{{ title }}</h1>

        <p class="page-head__subtitle">{{ subtitle }}</p>
    </div>
</section>

<section class="download-main">
    <div class="container">
        <div class="download-grid">
            {% if true %}
                <div class="download-release">
                    <div class="download-release__card">
                        <div class="download-release__error">
                            <span>{{ icon_alert | icon(20) }}</span>
                            <span>We found an issue with the current archive. A new archive will be available soon. Please check back later.</span>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="download-release">
                    <div class="download-release__card" data-download-card>
                        <div class="download-release__header" data-download-header hidden>
                            <div class="download-release__icon">{{ icon_package | icon(28) }}</div>

                            <div class="download-release__info">
                                <h2 class="download-release__title">Stage3 Tarball</h2>
                                <span class="download-release__date" data-download-date></span>
                            </div>
                        </div>

                        <div class="download-release__placeholder" data-download-loading>
                            <span class="spin">{{ icon_loader | icon(20) }}</span>
                            <span>Loading release info…</span>
                        </div>

                        <div class="download-release__error" data-download-error hidden>
                            <span>{{ icon_alert | icon(20) }}</span>
                            <span>Failed to load release info. Try again later.</span>
                        </div>

                        <div class="download-release__body" data-download-body hidden>
                            <div class="download-release__field">
                                <span class="download-release__field-label">File</span>
                                <span class="download-release__field-value" data-download-tarball></span>
                            </div>

                            <div class="download-release__field">
                                <span class="download-release__field-label">Checksum</span>
                                <span class="download-release__field-value" data-download-b3sum></span>
                            </div>
                        </div>

                        <div class="download-release__actions" data-download-actions hidden>
                            <a href="#" class="btn btn--primary btn--lg download-release__btn" data-download-tarball-link target="_blank" rel="noopener noreferrer">
                                <span>Download Tarball</span>
                            </a>

                            <a href="#" class="btn btn--ghost download-release__btn" data-download-b3sum-link target="_blank" rel="noopener noreferrer">
                                <span>B3sum Checksum</span>
                            </a>
                        </div>
                    </div>

                    <div class="download-warning">
                        <div class="download-warning__icon">{{ icon_alert | icon(20) }}</div>
                        <p>{{ warning }}</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>

<section class="requirements">
    <div class="container">
        <div class="section-head">
            <span class="section-head__eyebrow">Requirements</span>
            <h2 class="section-head__title">System Requirements</h2>

            <p class="section-head__subtitle">Two tiers — minimum specs to bootstrap, and recommended specs for comfortable builds.</p>
        </div>

        <div class="requirements__tiers">
            {% for tier in requirementTiers %}
                <div class="req-tier">
                    <div class="req-tier__head">
                        <h3 class="req-tier__title">{{ tier.title }}</h3>
                        <p class="req-tier__subtitle">{{ tier.subtitle }}</p>
                    </div>

                    <div class="req-tier__items">
                        {% for req in tier.items %}
                            <div class="req-card">
                                <div class="req-card__icon">{{ req.icon | icon(18) }}</div>

                                <div class="req-card__text">
                                    <span class="req-card__label">{{ req.label }}</span>
                                    <span class="req-card__value">{{ req.value }}</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
