<article class="developer-card">
    <div class="developer-card__visual">
        <div class="developer-card__avatar" aria-hidden="true">
            {% if developer.image %}
                <img class="developer-card__avatar-image" src="{{ developer.image }}" alt="" />
            {% else %}
                {{ avatarIcon | icon(34) }}
            {% endif %}
        </div>

        <span class="developer-card__index">{{ index }}</span>
    </div>

    <div class="developer-card__content">
        <p class="developer-card__role">{{ developer.role }}</p>
        <h3 class="developer-card__name">{{ developer.name }}</h3>
    </div>

    <div class="developer-card__links" aria-label="Contact links">
        {% for link in links %}
            <a class="developer-card__link" href="{{ link.url }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
                <span class="developer-card__link-icon">{{ link.icon | icon(16) }}</span>
                <span>{{ link.label }}</span>
                {% if link.external %}{{ externalIcon | icon(13) }}{% endif %}
            </a>
        {% endfor %}
    </div>
</article>
