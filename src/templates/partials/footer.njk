<footer class="footer">
    <div class="container footer__inner">
        <nav class="footer__links" aria-label="Footer navigation">
            {% for link in navLinks %}
                {% if link.external %}
                    <a href="{{ link.path }}" class="footer__link" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
                {% else %}
                    <a href="#{{ link.path }}" class="footer__link">{{ link.label }}</a>
                {% endif %}
            {% endfor %}

            {% for link in sourceLinks %}
                <a href="{{ link.path }}" class="footer__link" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
            {% endfor %}
        </nav>

        <p class="footer__copy">&copy; {{ year }} Vylen Linux</p>
    </div>
</footer>
