<header class="header" data-header>
    <div class="container header__inner">
        <a href="#/" class="header__brand">
            <span>Vylen Linux</span>
        </a>

        <nav class="header__nav" aria-label="Primary">
            <ul class="header__nav-list">
                {% for link in navLinks %}
                    <li>
                        {% if link.external %}
                            <a href="{{ link.path }}" class="header__nav-link" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
                        {% else %}
                            <a href="#{{ link.path }}" class="header__nav-link{% if link.path === currentPath %} header__nav-link--active{% endif %}"{% if link.path === currentPath %} aria-current="page"{% endif %}>{{ link.label }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <div class="header__actions">
            <button class="icon-button" data-theme-toggle aria-label="Switch color theme">
                <span data-theme-icon></span>
            </button>

            <button class="icon-button header__menu-toggle" data-menu-toggle aria-label="Toggle menu" aria-expanded="false">
                <span data-menu-icon></span>
            </button>
        </div>
    </div>

    <div class="header__mobile-nav" data-mobile-nav>
        <ul class="header__mobile-list">
            {% for link in navLinks %}
                <li>
                    {% if link.external %}
                        <a href="{{ link.path }}" class="header__mobile-link" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
                    {% else %}
                        <a href="#{{ link.path }}" class="header__mobile-link{% if link.path === currentPath %} header__mobile-link--active{% endif %}">{{ link.label }}</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
</header>
