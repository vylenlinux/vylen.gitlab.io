[
    // Vylen Linux developer configuration.
    // Each object below represents one developer or team card.
    // Copy an object to add another developer.
    // The order of objects determines the order of cards on the page.
    //
    // Fields:
    //   name   — the displayed name of the developer or team.
    //   role   — the developer's role in the project.
    //   image  — a direct avatar URL (JPG, PNG, WebP, or SVG), or null.
    //   contacts.github   — a GitHub URL, or null.
    //   contacts.gitlab   — a GitLab URL, or null.
    //   contacts.codeberg — a Codeberg URL, or null.
    //   contacts.email    — a mailto: link, or null.
    //
    // Use null for unavailable contacts; do not leave fields empty.
    // All web links should start with https://.
    // Example email: "mailto:developer@example.com".
    // JSON5 supports comments, unquoted keys, and trailing commas.

    {
        name: "CELESTIFYX",
        role: "Founder & Lead Developer",
        image: "https://gitlab.com/uploads/-/system/user/avatar/21889820/avatar.png",

        contacts: {
            gitlab: "https://gitlab.com/celestifyx",
            email: "mailto:wonkru-dev@proton.me"
        }
    }
]
